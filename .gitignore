.gitignore
# Ignore environment variables/secrets
.env

# Ignore Python virtual environments
venv/
.venv/
env/

# Ignore compiled Python files & cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore IDE configurations
.vscode/
.idea/

# Ignore all CSV data files
*.csv

# Ignore all Text files
*.txt

# EXCEPTION: Track Core Files and Requirements
!00_CORE_Files/*.txt
!requirements.txt

# EXCEPTION: Track Core Files
!00_CORE_Files/*.txt

# Ignore log files
*.log